# Sanjeevni Backend Environment Configuration Example
APP_ENV=development
SECRET_KEY=dev-insecure-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8001,http://127.0.0.1:8001,http://localhost:7860

# Database Configuration
DATABASE_URL=sqlite:///./clinician_risk.db

# LLM Configuration (OpenAI-compatible local endpoint, e.g. Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3
LLM_API_KEY=ollama

# Seed Account Passwords (required when APP_ENV != development)
SEED_WORKER_PASSWORD=change-me-worker-password
SEED_DOCTOR_PASSWORD=change-me-doctor-password
SEED_ADMIN_PASSWORD=change-me-admin-password
